<Window x:Class="WlcApCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WLC AP Cleaner" Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row for Menu -->
            <RowDefinition Height="Auto"/>
            <!-- Row for Buttons and Labels -->
            <RowDefinition Height="*"/>
            <!-- Row for DataGrid and CLI Output -->
            <RowDefinition Height="Auto"/>
            <!-- Row for Generate Button -->
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="AboutMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <!-- Top Button and Feedback Row -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- File Load Feedback Labels (Stacked Vertically) -->
            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="ShowRunFileLabel" Text="Show Run Config: Not Loaded" Margin="0,0,10,5"/>
                <TextBlock x:Name="ApSummaryFileLabel" Text="AP Summary: Not Loaded"/>
                <TextBlock x:Name="CountSummaryLabel" Text="Configured APs: 0 | Inactive APs: 0" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Top Button Row -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Load Show Run Config" Click="LoadShowRunConfig_Click" Margin="0,0,10,0" Width="150"/>
                <Button Content="Load AP Summary" Click="LoadApSummary_Click" Margin="0,0,10,0" Width="180"/>
                <Button Content="Compare" Click="CompareButton_Click" Margin="0,0,10,0" Width="100"/>
            </StackPanel>
        </Grid>

        <!-- Search and List -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Inactive APs -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Select All" Click="SelectAll_Click" Width="100" Margin="0,0,5,0"/>
                    <Button Content="Deselect All" Click="DeselectAll_Click" Width="100"/>
                </StackPanel>

                <DataGrid x:Name="InactiveApDataGrid" AutoGenerateColumns="False" Height="300" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsChecked}" Width="50"/>
                        <DataGridTextColumn Header="MAC Address" Binding="{Binding MacAddress}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- CLI Output -->
            <GroupBox Header="Generated CLI Commands" Grid.Column="1" Margin="10,0,0,0">
                <TextBox x:Name="CliOutput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" IsReadOnly="True"/>
            </GroupBox>
        </Grid>

        <!-- Generate Button -->
        <Button x:Name="GenerateDeleteCliButton" Content="Generate Delete CLI" Grid.Row="3" Margin="0,10,0,0" Height="30" Click="GenerateCli_Click" IsEnabled="False"/>
    </Grid>
</Window>
